# Database
DATABASE_URL="postgresql://user:password@host:5432/db"
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/db"

# Authentication
JWT_SECRET="your_jwt_secret_at_least_32_chars"
JWT_EXPIRES_IN="7d"

# AI
GEMINI_API_KEY=""
# Optional: each key adds that provider's model to the AI Tutor selector
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# AI requests per person per day (chat, image analysis, academic generation)
AI_DAILY_LIMIT="100"

# Other
NODE_ENV="development"
PORT=3001
CORS_ORIGIN="http://localhost:3000"
APP_URL="http://localhost:3000"


# Uploads (point to a persistent disk in production, e.g. /var/data/uploads)
UPLOADS_DIR=""

# Passkeys / email (optional)
DOMAIN=""
PASSKEY_RP_ID=""
PASSKEY_ORIGIN=""
RESEND_API_KEY=""
MAIL_FROM="NeuralVault <no-reply@nvaulty.online>"
